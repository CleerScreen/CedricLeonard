---
import { person } from '../data/content';
// Name in zwei Zeilen: Vornamen oben, Nachname unten (auf schmalen Bildschirmen bricht die erste Zeile um)
const parts = person.name.split(' ');
const lines = [parts.slice(0, -1).join(' '), parts[parts.length - 1]];
const mail = `mailto:${person.email}?subject=${encodeURIComponent('Gespräch zum Berufseinstieg')}`;
---
<section class="hero">
  <div class="wrap">
    <a class="status" href={mail} data-hero>
      <span class="status-text"><span class="dot" aria-hidden="true"></span>{person.status}</span>
      <span class="status-cta">{person.statusCta}</span>
    </a>

    <div class="bed" id="bed">
      <div class="name ghost" aria-hidden="true">{lines.map((l) => <span>{l}</span>)}</div>
      <h1 class="name printed" id="name">{lines.map((l) => <span>{l}</span>)}</h1>
      <div class="head" id="head" aria-hidden="true">
        <svg viewBox="0 0 30 40">
          <rect x="1" y="0" width="28" height="15" rx="3" fill="var(--surface)" stroke="var(--muted)" stroke-width="1.2" />
          <rect x="6" y="15" width="18" height="9" rx="1.5" fill="var(--bg-2)" stroke="var(--muted)" stroke-width="1.2" />
          <path d="M10 24 H20 L16.2 35 H13.8 Z" fill="var(--muted)" />
          <circle class="tip" cx="15" cy="37.5" r="2.4" fill="var(--accent)" />
        </svg>
      </div>
    </div>
    <p class="readout mono" id="readout" aria-hidden="true">&nbsp;</p>

    <p class="lead" data-hero><strong>{person.role} aus {person.location}.</strong> {person.intro} {person.seeking}</p>
    <div class="cta" data-hero>
      <a class="btn btn-primary" href="#projekte">Projekte ansehen</a>
      <a class="btn" href="#kontakt">Kontakt aufnehmen</a>
    </div>
  </div>
</section>

<script>
  // Name wird wie im 3D-Drucker Schicht für Schicht gedruckt (Schlangenlinie, von unten nach oben).
  const bed = document.getElementById('bed');
  const name = document.getElementById('name');
  const head = document.getElementById('head');
  const readout = document.getElementById('readout');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const pad = (n: number) => String(n).padStart(2, '0');

  function finish(layers: number) {
    if (!bed || !name || !readout) return;
    name.style.clipPath = 'none';
    bed.classList.add('done');
    requestAnimationFrame(() => name.classList.remove('hot'));
    readout.textContent = `Druck fertig · ${layers} Schichten · 0,20 mm · PLA`;
  }

  function print() {
    if (!bed || !name || !head || !readout) return;
    const w = name.offsetWidth, h = name.offsetHeight;
    const layers = Math.round(Math.min(46, Math.max(26, h / 7)));
    const lh = h / layers;
    name.style.setProperty('--lh', `${lh}px`);
    if (reduce) { finish(layers); return; }
    bed.classList.remove('done');
    name.classList.add('hot');
    const D = Math.max(48, 2700 / layers);
    const t0 = performance.now();
    name.style.clipPath = `polygon(0 ${h}px, ${w}px ${h}px, ${w}px ${h}px, 0 ${h}px)`;
    const step = (t: number) => {
      const e = t - t0;
      const i = Math.floor(e / D);
      if (i >= layers) { finish(layers); return; }
      const p = (e % D) / D;
      const rtl = i % 2 === 1;
      const x = rtl ? w * (1 - p) : w * p;
      const yb = h - i * lh, yt = yb - lh;
      const a = rtl ? x : 0, b = rtl ? w : x;
      name.style.clipPath = `polygon(0px ${h}px, ${w}px ${h}px, ${w}px ${yb}px, ${b}px ${yb}px, ${b}px ${yt}px, ${a}px ${yt}px, ${a}px ${yb}px, 0px ${yb}px)`;
      head.style.transform = `translate(${x}px, ${yt}px)`;
      readout.innerHTML = `Schicht <b>${pad(i + 1)}</b> / ${layers} · 0,20 mm · PLA · 215 °C`;
      requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  }

  const go = () => setTimeout(print, 300);
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(go); else go();
</script>

<style>
  .hero { padding: clamp(120px, 16vw, 180px) 0 clamp(64px, 9vw, 110px); position: relative; overflow-x: clip; }

  .status {
    display: flex; flex-wrap: wrap; width: fit-content; max-width: 100%; align-items: center; gap: 8px 12px;
    padding: 6px 6px 6px 14px; border: 1px solid color-mix(in srgb, var(--accent-2) 45%, var(--line)); border-radius: 22px;
    background: color-mix(in srgb, var(--accent-2) 10%, var(--bg)); font-size: .98rem; font-weight: 500; color: var(--text);
    text-decoration: none; transition: transform .2s, border-color .2s, box-shadow .2s;
  }
  .status:hover { transform: translateY(-2px); border-color: var(--accent-2); box-shadow: 0 10px 30px -14px var(--accent-2); }
  .status-text { display: inline-flex; align-items: center; gap: 10px; }
  .status-cta { background: var(--accent-2); color: var(--bg); font-weight: 600; padding: 7px 14px; border-radius: 16px; white-space: nowrap; }
  .dot { width: 9px; height: 9px; border-radius: 50%; background: var(--accent-2); box-shadow: 0 0 0 0 var(--accent-2); animation: pulse 2.2s infinite; flex: none; }
  @keyframes pulse { 70% { box-shadow: 0 0 0 10px transparent; } 100% { box-shadow: 0 0 0 0 transparent; } }

  .bed { position: relative; display: block; width: fit-content; max-width: 100%; margin: clamp(22px, 4vw, 36px) 0 6px; }
  .name { font-family: var(--font-display); font-size: clamp(2.9rem, 9.4vw, 7.6rem); line-height: .92; letter-spacing: -0.045em; font-weight: 700; margin: 0; }
  .name span { display: block; }
  .printed {
    --ink: var(--text);
    background: repeating-linear-gradient(to bottom, var(--ink) 0, var(--ink) calc(var(--lh, 6px) - 0.8px), color-mix(in srgb, var(--ink) 62%, transparent) calc(var(--lh, 6px) - 0.8px), color-mix(in srgb, var(--ink) 62%, transparent) var(--lh, 6px));
    -webkit-background-clip: text; background-clip: text; color: transparent;
    transition: --ink 1.6s ease;
  }
  .printed.hot { --ink: var(--accent); transition: none; }
  .ghost { position: absolute; inset: 0; color: transparent; -webkit-text-stroke: 1px color-mix(in srgb, var(--muted) 55%, transparent); transition: opacity .8s ease; pointer-events: none; }
  .bed.done .ghost { opacity: 0; }
  .head { position: absolute; left: 0; top: 0; width: 30px; height: 40px; margin-left: -15px; margin-top: -40px; pointer-events: none; transition: opacity .5s ease; will-change: transform; }
  .head svg { width: 100%; height: 100%; overflow: visible; }
  .tip { filter: drop-shadow(0 0 6px var(--accent)); }
  .bed.done .head { opacity: 0; visibility: hidden; }
  .readout { font-size: .8rem; line-height: 1.4; color: var(--muted); font-variant-numeric: tabular-nums; min-height: 1.4em; }
  .readout :global(b) { color: var(--accent); font-weight: 500; }

  .lead { margin-top: clamp(22px, 3vw, 30px); max-width: 58ch; }
  .lead strong { color: var(--text); font-weight: 600; }
  .cta { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 30px; }
  .btn:not(.btn-primary) { background: color-mix(in srgb, var(--bg) 70%, transparent); }

  @media (prefers-reduced-motion: reduce) {
    .dot { animation: none; }
  }
</style>
